# WhatsApp Business API Configuration
# Obtenha essas credenciais em: https://developers.facebook.com/apps/

# Phone Number ID (encontrado no painel do WhatsApp Business)
WHATSAPP_PHONE_NUMBER_ID=

# Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Access Token (gerado no painel de desenvolvedor do Meta)
WHATSAPP_ACCESS_TOKEN=

# N8N Configuration (opcional)
N8N_ENCRYPTION_KEY=whatsapp-contacts-encryption-key
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_PORT=5679
WEBHOOK_URL=http://localhost:5679/
NODE_ENV=production
NODE_FUNCTION_ALLOW_BUILTIN=fs,path
