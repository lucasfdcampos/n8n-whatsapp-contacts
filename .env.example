# WhatsApp Business API Configuration
# Obtenha essas credenciais em: https://developers.facebook.com/apps/

# Phone Number ID (encontrado no painel do WhatsApp Business)
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_aqui

# Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=seu_business_account_id_aqui

# Access Token (gerado no painel de desenvolvedor do Meta)
WHATSAPP_ACCESS_TOKEN=seu_access_token_aqui

# N8N Configuration (opcional)
# N8N_ENCRYPTION_KEY=your-encryption-key-here